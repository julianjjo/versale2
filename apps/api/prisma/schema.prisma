// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  role          Role     @default(USER)
  isVerified    Boolean  @default(false)
  verificationToken String? @unique
  resetToken    String? @unique
  resetTokenExpires DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  products      Product[]
  orders        Order[]
  cart          Cart?
  reviews       Review[]
  favorites     Favorite[]
}

enum Role {
  USER
  ADMIN
}

model Product {
  id            String   @id @default(uuid())
  title         String
  description   String
  category      String   // e.g., "Tops", "Jeans"
  brand         String?
  size          String   // S, M, L, XL, etc.
  condition     String   // "New", "Like New", "Good", "Fair"
  price         Float
  sellerId      String
  seller        User     @relation(fields:[sellerId], references:[id])
  isApproved    Boolean  @default(false) // for admin moderation
  rejectedAt    DateTime?
  rejectionReason String?
  soldAt        DateTime? // one-of-a-kind item: set once purchased, then it is gone
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        OrderItem[]
  reviews       Review[]
  images        Json?    // Changed to Json type (SQLite compatible), nullable
  cartItems     CartItem[] @relation("CartItemProduct")
  favoritedBy   Favorite[]

  // The public catalog always filters on isApproved + soldAt and sorts by
  // createdAt desc, so this covers the hottest query in the product end to end.
  // Without it every listing page was a full table scan.
  @@index([isApproved, soldAt, createdAt])
  // Admin moderation queue buckets on isApproved + rejectedAt.
  @@index([isApproved, rejectedAt])
  // Resolving a seller's own listings.
  @@index([sellerId])
}

model Cart {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields:[userId], references:[id])
  items         CartItem[] @relation("CartItemCart")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String
  cart          Cart     @relation("CartItemCart", fields:[cartId], references:[id])
  productId     String
  product       Product  @relation("CartItemProduct", fields:[productId], references:[id])
  quantity      Int
  // denormalized fields for price snapshot (optional)
  priceAtAdd    Float

  @@unique([cartId, productId])
}

model Order {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields:[userId], references:[id])
  status        OrderStatus @default(PENDING)
  totalAmount   Float
  shippingAddress Json   // or separate ShippingAddress model (now required)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         OrderItem[] @relation("OrderItemOrder")

  // Order history is always "this user's orders, newest first".
  @@index([userId, createdAt])
  // The admin dashboard aggregates revenue by status.
  @@index([status])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation("OrderItemOrder", fields:[orderId], references:[id])
  productId     String
  product       Product  @relation(fields:[productId], references:[id])
  quantity      Int
  price         Float    // price at time of purchase

  @@index([orderId])
  @@index([productId])
}

model Review {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields:[userId], references:[id])
  productId     String
  product       Product  @relation(fields:[productId], references:[id])
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  // Every product page loads its reviews newest-first.
  @@index([productId, createdAt])
}

model Favorite {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields:[userId], references:[id])
  productId     String
  product       Product  @relation(fields:[productId], references:[id])
  createdAt     DateTime @default(now())

  // A user can favorite a given product only once.
  @@unique([userId, productId])
  // The favorites page always loads "this user's favorites, newest first".
  @@index([userId, createdAt])
}
