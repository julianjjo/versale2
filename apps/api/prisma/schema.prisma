// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  role          Role     @default(USER)
  isVerified    Boolean  @default(false)
  verificationToken String? @unique
  resetToken    String? @unique
  resetTokenExpires DateTime?
  tokenVersion  Int      @default(0)
  // Item 8 follow-up: the signup checkbox ("Confirmo que soy mayor de 18
  // años y acepto los Términos...") was never actually enforced or recorded
  // server-side — SignupDto now requires it, and this is the timestamp that
  // stands as evidence of consent. Nullable because accounts created before
  // this field existed have no such record.
  termsAcceptedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  products      Product[]
  orders        Order[]
  cart          Cart?
  reviews       Review[]
  favorites     Favorite[]
  productReports ProductReport[] @relation("ProductReportReporter")
  reviewedReports ProductReport[] @relation("ProductReportReviewer")
  productQuestions ProductQuestion[]
  reviewHelpfulVotes ReviewHelpfulVote[]
  notifications Notification[]
}

enum Role {
  USER
  ADMIN
}

// Stock lifecycle of a one-of-a-kind garment. Deliberately separate from the
// moderation lifecycle (isApproved/rejectedAt/rejectionReason): a listing can
// be pending review AND available stock-wise; they answer different questions.
// WITHDRAWN is reserved for the seller's definitive takedown wired up by
// "Mis publicaciones" (roadmap 1.3); today only AVAILABLE and SOLD are ever
// written — the seller's temporary hide toggle remains `pausedAt`.
enum ProductStatus {
  AVAILABLE
  SOLD
  WITHDRAWN
}

model Product {
  id            String   @id @default(uuid())
  title         String
  description   String
  category      String   // e.g., "Tops", "Jeans"
  brand         String?
  size          String   // S, M, L, XL, etc.
  condition     String   // "New", "Like New", "Good", "Fair"
  price         Float
  sellerId      String
  seller        User     @relation(fields:[sellerId], references:[id])
  isApproved    Boolean  @default(false) // for admin moderation
  rejectedAt    DateTime?
  rejectionReason String?
  // One-of-a-kind item: checkout flips this to SOLD inside its transaction via
  // a conditional updateMany({ where: { id, status: AVAILABLE } }) whose row
  // count serializes concurrent buyers — exactly one checkout wins. The sale
  // timestamp itself lives on the winning OrderItem's order (createdAt).
  status        ProductStatus @default(AVAILABLE)
  // Seller-controlled, independent of moderation: set to temporarily hide an
  // otherwise-approved listing from the public catalog without deleting it or
  // sending it back through re-review (see the `update()` needsReview branch,
  // which is unrelated to this). Cleared by the seller to make it visible
  // again. Orthogonal to isApproved/status the same way status already sits
  // outside the isApproved/rejectedAt moderation partition.
  pausedAt      DateTime?
  // Counts detail-page views from anyone other than the product's own
  // seller (see ProductsService#findOne) — a seller re-checking their own
  // listing shouldn't inflate the interest signal they're trying to read.
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        OrderItem[]
  reviews       Review[]
  images        Json?    // [{ url, alt }] — max 6, solo URLs del bucket R2 (valida el DTO). Nullable.
  // Texto libre curado por el vendedor (item 4): medidas de la prenda y
  // defectos declarados. Opcionales: un listing sin ellos es válido.
  measurements  String?
  defects       String?
  cartItems     CartItem[] @relation("CartItemProduct")
  favoritedBy   Favorite[]
  reports       ProductReport[]
  questions     ProductQuestion[]

  // The public catalog always filters on isApproved + status + pausedAt and
  // sorts by createdAt desc, so this covers the hottest query in the product
  // end to end. Without it every listing page was a full table scan.
  @@index([isApproved, status, pausedAt, createdAt])
  // Same shape, for the catalog's price-sorted view (?sortBy=price_asc/desc) —
  // without it, sorting by price degrades to an in-memory sort over every
  // approved/unsold/unpaused row as the catalog grows.
  @@index([isApproved, status, pausedAt, price])
  // findAll()'s category/size/condition filters are equality matches applied
  // on top of the same visibility prefix — almost every visible row shares
  // isApproved/status/pausedAt, so without these the existing indexes above
  // only narrow the scan to "the whole catalog" and each filter still walks
  // every visible row. `brand` isn't indexed here on purpose: findAll()
  // matches it with `contains` (a substring search), which a plain index
  // can't accelerate in SQLite anyway.
  @@index([isApproved, status, pausedAt, category])
  @@index([isApproved, status, pausedAt, size])
  @@index([isApproved, status, pausedAt, condition])
  // Admin moderation queue buckets on isApproved + rejectedAt.
  @@index([isApproved, rejectedAt])
  // Resolving a seller's own listings.
  @@index([sellerId])
}

model Cart {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields:[userId], references:[id])
  items         CartItem[] @relation("CartItemCart")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String
  cart          Cart     @relation("CartItemCart", fields:[cartId], references:[id])
  productId     String
  product       Product  @relation("CartItemProduct", fields:[productId], references:[id])
  quantity      Int
  // denormalized fields for price snapshot (optional)
  priceAtAdd    Float

  @@unique([cartId, productId])
  // products.service.ts#update() deletes stale cart snapshots by productId
  // alone whenever a price actually changes — the @@unique above is keyed on
  // [cartId, productId] with cartId leading, so it can't serve a plain
  // "every cart holding this product" lookup (no leftmost-prefix match).
  // Every sibling join table that's ever queried by productId alone
  // (OrderItem, Review, ProductQuestion) already carries this same index.
  @@index([productId])
}

model Order {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields:[userId], references:[id])
  status        OrderStatus @default(PENDING)
  totalAmount   Float
  shippingAddress Json   // or separate ShippingAddress model (now required)
  trackingNumber String?
  // Item 12 timestamps that drive the automated deadlines: the 7-day
  // unshipped refund counts from paidAt, the 48h dispute window and the
  // 30-day dispute expiry from deliveredAt / disputedAt.
  paidAt        DateTime?
  deliveredAt   DateTime?
  disputedAt    DateTime?
  disputeExpiresAt DateTime?
  disputeResolvedAt DateTime?
  disputeReason String?
  disputePhotos Json?    // [{ url, alt }] — same shape as Product.images
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         OrderItem[] @relation("OrderItemOrder")
  notifications Notification[]
  payments      Payment[]

  // Cron sweeps filter by these deadline columns every hour.
  @@index([status, paidAt])
  @@index([status, disputeExpiresAt])
  // autoCancelStalePendingOrders' own sweep, same shape as the two above.
  @@index([status, createdAt])

  // Order history is always "this user's orders, newest first".
  @@index([userId, createdAt])
  // The admin dashboard aggregates revenue by status.
  @@index([status])
  // getAllOrders/exportOrdersCsv default to no search filter (buildOrderSearchWhere
  // returns {} when the admin hasn't typed one) and always sort by createdAt desc —
  // the default, most-visited state of /admin/orders. None of the indexes
  // above apply to an unconditional sort: they're all led by `status` or
  // `userId`, neither of which this query filters on.
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  DISPUTED
  REFUNDED
}

// Item 16: pagos de MercadoPago. paymentId único = la idempotencia del
// webhook vive en la base de datos: MP reintenta notificaciones y dos
// webhooks con el mismo pago no pueden crear dos filas ni procesarse dos
// veces.
model Payment {
  id        String   @id @default(uuid())
  // ID del pago en MercadoPago (data.id de la notificación).
  paymentId String   @unique
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  status    String   // estado reportado por MP (approved, rejected…)
  amount    Float
  rawPayload Json?   // respuesta completa de MP para auditoría/soporte
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation("OrderItemOrder", fields:[orderId], references:[id])
  productId     String
  product       Product  @relation(fields:[productId], references:[id])
  quantity      Int
  price         Float    // price at time of purchase

  @@index([orderId])
  @@index([productId])
}

model Review {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields:[userId], references:[id])
  productId       String
  product         Product  @relation(fields:[productId], references:[id])
  rating          Int
  comment         String?
  sellerReply     String?
  sellerRepliedAt DateTime?
  createdAt       DateTime @default(now())
  helpfulVotes    ReviewHelpfulVote[]

  // One review per buyer per listing, enforced by the database itself — the
  // app-level check can't close the race between two concurrent POSTs.
  @@unique([userId, productId])
  // Every product page loads its reviews newest-first.
  @@index([productId, createdAt])
}

model ReviewHelpfulVote {
  id        String   @id @default(uuid())
  reviewId  String
  // Cascades: once the review is gone (author deletes it, admin moderates it
  // away) the votes on it have nothing left to count toward and must not
  // block that deletion the way a plain RESTRICT would.
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  // A voter can mark a given review helpful only once.
  @@unique([reviewId, userId])
}

model Favorite {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields:[userId], references:[id])
  productId     String
  product       Product  @relation(fields:[productId], references:[id])
  createdAt     DateTime @default(now())

  // A user can favorite a given product only once.
  @@unique([userId, productId])
  // The favorites page always loads "this user's favorites, newest first".
  @@index([userId, createdAt])
}

enum ReportStatus {
  OPEN
  DISMISSED
}

enum ReportCategory {
  FRAUD
  INAPPROPRIATE
  MISMATCH
  OTHER
}

model ProductReport {
  id         String   @id @default(uuid())
  productId  String
  // Cascades: once the reported product is gone, the report has served its
  // purpose and must not be the thing standing between an admin and actually
  // removing a listing a report flagged as bad — a plain RESTRICT here would
  // make products.service.ts#remove()'s P2003 handler block exactly the
  // moderation action this whole feature exists to enable.
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporterId String
  // Left as the default RESTRICT (matching Review/Favorite/Order's existing
  // User relations) — deleting a reporter's account is a separate concern
  // from resolving what they reported, and shouldn't quietly erase reports
  // still open against other products.
  reporter   User     @relation("ProductReportReporter", fields: [reporterId], references: [id])
  reason     String
  category   ReportCategory @default(OTHER)
  // OPEN until an admin acts on it — dismiss() now updates this row instead
  // of deleting it, so there's a durable record of every report an admin has
  // ever ruled on, not just the ones still awaiting review.
  status       ReportStatus @default(OPEN)
  reviewedById String?
  // Unlike `reporter` above, this is optional, so Prisma's own default for an
  // optional relation applies: ON DELETE SET NULL. Deliberately not
  // RESTRICT — an admin's account being deleted shouldn't block on every
  // report they ever reviewed; the audit entry (status, reviewedAt) survives
  // with reviewedById simply cleared.
  reviewer     User?        @relation("ProductReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Resubmitting isn't a second signal against the listing, it's the same
  // complaint — upserting on this keeps the admin queue from growing
  // unbounded from one reporter retrying the same product, while still
  // letting them refine their reason (see ReportsService#create).
  @@unique([productId, reporterId])
  // The admin queue's default view filters on status and sorts by updatedAt —
  // this covers it end to end. There's deliberately no separate @@index on
  // createdAt alone: nothing in reports.service.ts filters or sorts on it by
  // itself, so a second index there would just cost writes for no reads.
  @@index([status, updatedAt])
}

model ProductQuestion {
  id         String   @id @default(uuid())
  productId  String
  // Cascades like ProductReport's: once the product is gone, a question
  // about it has nothing left to answer, and must not stand in the way of
  // deleting the listing the way a plain RESTRICT would.
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  askerId    String
  // Left as the default RESTRICT (matching Review/Favorite/Order/
  // ProductReport's User relations) — deleting an asker's account is a
  // separate concern from the question they asked.
  asker      User     @relation(fields: [askerId], references: [id])
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime @default(now())

  // The product page always loads its Q&A newest-first.
  @@index([productId, createdAt])
  // getAllForAdmin has no productId filter at all — a global, unconditional
  // sort the [productId, createdAt] index above can't serve (leading column
  // unused).
  @@index([createdAt])
}

enum NotificationType {
  ORDER_SHIPPED
  ORDER_CANCELLED
  ORDER_STATUS_CHANGED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  // Left as the default RESTRICT (matching Review/Favorite/Order/
  // ProductReport/ProductQuestion's User relations) — a notification is a
  // record of something that happened to this account, not disposable
  // metadata, so it doesn't get a cascade of its own.
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  orderId   String?
  // Optional and SET NULL: nothing in this API deletes an Order today, but
  // if that ever changes, a notification about it should survive as history
  // rather than block the delete or vanish with it.
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  // The notification bell always loads "mine, newest first".
  @@index([userId, createdAt])
  // ...and needs an unread count/list without scanning every notification.
  @@index([userId, read])
}
