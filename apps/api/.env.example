DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001

# Origins allowed to call the API from a browser (comma-separated).
# Leave unset locally: it defaults to the web app on localhost/127.0.0.1
# ports 3000 (dev) and 3100 (e2e). Set it in every deployed environment.
# CORS_ORIGIN="https://versale.example.com"

# Set to "production" in deployed environments: it also stops the Swagger UI
# at /api from being published to anonymous visitors.
# NODE_ENV="development"

# Rate limiting (per IP, per endpoint, per minute). Both default to a sane
# ceiling and must be positive integers — a non-numeric or negative value now
# fails at boot instead of silently reverting to the default.
# THROTTLE_LIMIT=300         # global default across all endpoints
# AUTH_THROTTLE_LIMIT=30     # stricter budget for /auth/login and /auth/signup

# REQUIRED behind a reverse proxy, load balancer or CDN. Express resolves the
# client IP from the socket unless it is told how many proxy hops to skip, and
# the rate limits key on that IP — leave this unset behind a proxy and every
# visitor shares one budget, so 30 requests from anyone lock all users out of
# login. Set it to the number of proxies in front of the API (usually 1).
# TRUST_PROXY=1

# Cloudflare R2 (image storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="versale"
# Optional: override public URL base. Defaults to https://<accountId>.r2.cloudflarestorage.com/<bucket>
R2_PUBLIC_BASE_URL=""
