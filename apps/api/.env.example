DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001

# Origins allowed to call the API from a browser (comma-separated).
# Leave unset locally: it defaults to the web app on localhost/127.0.0.1
# ports 3000 (dev) and 3100 (e2e). Set it in every deployed environment.
# CORS_ORIGIN="https://versale.example.com"

# Set to "production" in deployed environments.
# NODE_ENV="development"

# Swagger UI at /api is OFF by default (fail-closed) — set to "true" only in
# local/dev environments where publishing the full API surface is fine.
# ENABLE_SWAGGER="true"

# Rate limiting (per IP, per endpoint, per minute). Both default to a sane
# ceiling; a non-numeric or non-positive value falls back to that default
# instead of bricking the API (e.g. THROTTLE_LIMIT=-5 used to 429 every
# single request instead of falling back to the default).
# THROTTLE_LIMIT=300         # global default across all endpoints
# AUTH_THROTTLE_LIMIT=30     # stricter budget for /auth/login and /auth/signup
# FORGOT_PASSWORD_THROTTLE_LIMIT=10   # its own, tighter budget for /auth/forgot-password
# PRODUCTS_SEARCH_THROTTLE_LIMIT=60   # tighter budget for GET /products (unauthenticated, runs a double query)

# Item 17: los correos de verificación/restablecimiento YA se envían vía
# Brevo. Estos flags siguen existiendo solo para probar los flujos end-to-end
# en local/dev sin buzón: devuelven el token crudo en la respuesta. Defaults a
# unset/false (nunca exponer el token) para que un despliegue mal configurado
# no filtre un token de toma de cuenta completa.
# AUTH_EXPOSE_RESET_TOKEN="true"

# Item 17: ídem, para el token de verificación de correo de /auth/signup.
# AUTH_EXPOSE_VERIFICATION_TOKEN="true"

# Item 17: base de los enlaces que llegan por correo (verify-email /
# reset-password). Debe apuntar al frontend visible por el destinatario.
# WEB_APP_URL="http://localhost:3000"

# REQUIRED behind a reverse proxy, load balancer or CDN. Express resolves the
# client IP from the socket unless it is told how many proxy hops to skip, and
# the rate limits key on that IP - leave this unset behind a proxy and every
# visitor shares one budget, so 30 requests from anyone lock all users out of
# login. Set it to the number of proxies in front of the API (usually 1).
# TRUST_PROXY_HOPS=1

# Cloudflare R2 (image storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="versale"
# Optional: override public URL base. Defaults to https://<accountId>.r2.cloudflarestorage.com/<bucket>
R2_PUBLIC_BASE_URL=""

# Brevo (email transaccional) - https://app.brevo.com/settings/keys/api
# Sin BREVO_API_KEY el servicio queda en modo no-op (no rompe dev).
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Versale"
MP_ACCESS_TOKEN=""
